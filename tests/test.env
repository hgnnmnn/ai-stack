# Fixed credentials for the local test stack only - not used anywhere real.
LITELLM_MASTER_KEY=sk-test-master-key-0123456789abcdef0123456789abcdef
POSTGRES_USER=litellm_test
POSTGRES_PASSWORD=litellm_test_password
POSTGRES_DB=litellm_test
REDIS_PASSWORD=redis_test_password

# Host port for the isolated `ai-stack-test` compose project. Deliberately
# not 4000 so the suite can run while the real stack is up.
GATEWAY_PORT=4100

# Where scripts/render-litellm-config.sh writes the test Gateway config and
# what docker-compose.yml mounts for it. Without this the suite rendered into
# litellm/config.yaml -- the live Gateway's file -- which then served test
# values (e.g. supports_vision false on llama-chat) after the next restart.
LITELLM_CONFIG_FILE=./tests/litellm-config.yaml

# Only read by scripts/render-litellm-config.sh; the stub Backends ignore them.
CHAT_ARGS=--ctx-size 524288 --parallel 4
CODER_ARGS=--ctx-size 524288 --parallel 2
FIM_ARGS=--ctx-size 8192 --parallel 1
CHAT_MMPROJ_FILE=
CODER_MMPROJ_FILE=stub
