# Nominal per-token pricing shared by all three local Backends. The models
# cost nothing to run; the numbers exist so spend tracking and the Grafana
# panels have non-zero values to aggregate.
x-local-cost: &local-cost
    input_cost_per_token: 0.00000002
    output_cost_per_token: 0.00000002

# TEMPLATE. litellm/config.yaml is generated from this file by
# scripts/render-litellm-config.sh (`make litellm-config`, run automatically
# by `make up`); edit this file, not the output. The ${...} placeholders are
# derived from the same *_ARGS lines in .env that docker-compose.backends.yml
# hands to llama-server, so Backend and Gateway can't drift apart:
#   *_CTX_PER_SLOT  <- --ctx-size / --parallel; max_input_tokens (NOT the total
#                      --ctx-size: a single request only ever sees one slot;
#                      matches /props n_ctx)
#   *_VISION        <- true iff *_MMPROJ_FILE is set in .env
# max_parallel_requests is deliberately NOT set. LiteLLM answers the request
# over the limit with an immediate 429 (router MaxParallelRequestsLimit), it
# does not queue; without the limit, surplus requests wait inside llama-server
# until a slot is free. Verified in litellm-database v1.104.2 and by the
# llama-coder 429s in Zed when it was 1 against --parallel 2.
# supports_reasoning / supports_function_calling stay hand-set below; they
# come from the model's chat template and are not readable from /props.
#
# The supports_* flags drive the Model Hub "Features" column and what Clients
# are told they may send. Both chat Backends run --jinja, so tool calling and
# reasoning come from the model's own chat template; verified live against
# each Backend (single + parallel tool call, reasoning_content present).
# supports_vision follows *_MMPROJ_FILE (see above). Both chat Backends are
# MoE/hybrid models with q8_0 KV cache plus a vision projector, the combination
# ADR 0002 flagged as a risk -- watch for degraded image understanding, not yet
# empirically ruled out.
model_list:
    - model_name: llama-chat
      litellm_params:
          model: openai/llama-chat
          api_base: http://llama-chat:8001/v1
          api_key: "not-needed"
          timeout: 1800
          <<: *local-cost
      model_info:
          mode: chat
          max_input_tokens: ${CHAT_CTX_PER_SLOT}
          supports_reasoning: true
          supports_function_calling: true
          supports_parallel_function_calling: true
          supports_vision: ${CHAT_VISION}
    - model_name: llama-coder
      litellm_params:
          model: openai/llama-coder
          api_base: http://llama-coder:8002/v1
          api_key: "not-needed"
          timeout: 1800
          <<: *local-cost
      model_info:
          mode: chat
          max_input_tokens: ${CODER_CTX_PER_SLOT}
          supports_reasoning: true
          supports_function_calling: true
          supports_parallel_function_calling: true
          supports_vision: ${CODER_VISION}
    - model_name: llama-fim
      litellm_params:
          model: text-completion-openai/llama-fim
          api_base: http://llama-fim:8004/v1
          api_key: "not-needed"
          timeout: 120
          <<: *local-cost
      model_info:
          # Raw /v1/completions against a base model: no chat template, so no
          # tool calling and no reasoning.
          mode: completion
          max_input_tokens: ${FIM_CTX_PER_SLOT}
litellm_settings:
    callbacks: ["prometheus"]
    require_auth_for_metrics_endpoint: false
    drop_params: true
    # Exact-match response cache across every deployment, including the ones
    # managed in the DB rather than here. supported_call_types is deliberately
    # left at its default so all of them are covered (chat, raw completions,
    # embeddings, rerank, responses) instead of a list that goes stale when a
    # Backend is added.
    #
    # Backed by the `redis` service in docker-compose.yml, which exists for the
    # Gateway's rate-limit/budget/router state (ADR 0007), not for this. Read
    # that ADR before treating a bigger cache as a win: f104cfd removed a
    # Valkey-backed cache from this stack precisely because exact-match caching
    # gets near-zero hit rates on multi-turn chat -- every request carries the
    # full history, so every request is unique. Redis does not change that.
    #
    # This moved off `type: local` only because that was an in-process LRU
    # hardcoded to 200 entries shared by every Model ID (Cache() takes no
    # max_size_in_memory, no env knob), so it wasn't doing much either, and
    # pointing at an already-running Redis costs nothing. llama-fim's raw
    # completions are the workload where it might actually pay off. If the
    # Prometheus litellm_*cache* series still shows ~0 hits, set cache: false
    # rather than trying a third backend.
    #
    # Unchanged consequence worth knowing: an identical request replays the
    # stored answer for the whole ttl, so "regenerate" in a Client returns the
    # same text even at --temp 1.0. It now also does so across restarts.
    cache: true
    cache_params:
        type: redis
        host: os.environ/REDIS_HOST
        port: os.environ/REDIS_PORT
        password: os.environ/REDIS_PASSWORD
        ttl: 600
general_settings:
    master_key: os.environ/LITELLM_MASTER_KEY
    database_url: os.environ/DATABASE_URL
    use_x_forwarded_for: true
    # Closes the "environment-credential login" path LiteLLM warns about
    # since v1.102: without this, anyone with LITELLM_MASTER_KEY (or
    # UI_USERNAME/UI_PASSWORD, unused here) can sign in to /ui as a shared
    # proxy-admin identity. Requires a DB-backed admin user (Internal Users
    # tab, role Proxy Admin, own password) to already exist and be verified
    # working -- flipping this before that locks out /ui entirely.
    disable_env_credential_login: true
    mcp_trusted_proxy_ranges:
        - "10.0.0.0/24"

# Router state shared through the same Redis: deployment cooldowns, usage- and
# latency-based routing counters, rate-limit and budget accounting. Separate
# from cache_params above -- LiteLLM does not derive one from the other, and
# leaving this out is what keeps the "No Redis configured" banner up even with
# the cache pointed at Redis.
router_settings:
    redis_host: os.environ/REDIS_HOST
    redis_port: os.environ/REDIS_PORT
    redis_password: os.environ/REDIS_PASSWORD
