# Copy to .env and fill in real values. .env is gitignored.

# Loads the real GPU-passthrough Backends (issues #2/#3) alongside the base
# stack, so `docker compose up -d` (no -f flags) starts everything except the
# optional Grafana/Prometheus monitoring (see `make monitoring`). Remove this
# line (or use only -f docker-compose.yml) to run the Gateway stack without
# the Backends, e.g. against an already-running pair on :8001/:8002.
COMPOSE_FILE=docker-compose.yml:docker-compose.backends.yml

# Absolute path to the directory containing GGUF model files, mounted
# read-only into the Backends (issues #2/#3).
MODELS_DIR=/home/CHANGE_ME/models

# GGUF filenames within MODELS_DIR for each Backend, relative paths are fine.
# If a model is split into multiple shards (e.g. model-00001-of-00003.gguf),
# point at the first shard.
CHAT_MODEL_FILE=unsloth/Ornith-1.0-35B-GGUF/Ornith-1.0-35B-UD-Q4_K_M.gguf
# Dense, not MoE — deliberate choice, highest SWE-bench Verified score of
# the locally evaluated options despite the architecture disadvantage on
# this hardware (see ADR 0005). Drop-in MoE alternative already on disk if
# throughput ever matters more than quality:
# unsloth/Qwen3-Coder-Next-GGUF/Qwen3-Coder-Next-UD-Q4_K_XL.gguf
CODER_MODEL_FILE=unsloth/Qwen3.6-27B-MTP-GGUF/Qwen3.6-27B-UD-Q4_K_XL.gguf
# Codestral-22B for FIM quality over the previous tiny 1.5B base model; note
# its FIM token order is Suffix-Prefix-Middle, wired via --spm-infill in
# docker-compose.backends.yml (see ADR 0006). Drop-in low-latency fallback:
# QuantFactory/Qwen2.5-Coder-1.5B-GGUF/Qwen2.5-Coder-1.5B.Q8_0.gguf
FIM_MODEL_FILE=bartowski/Codestral-22B-v0.1-GGUF/Codestral-22B-v0.1-Q4_K_M.gguf

# Diffusion-model weights dir for the optional Imagegen Mode (ComfyUI,
# docker-compose.comfyui.yml / `make imagegen`). Kept separate from MODELS_DIR;
# put FLUX.1-schnell / SD3.5 checkpoints, VAEs, LoRAs, etc. under here in
# ComfyUI's usual subfolders (checkpoints/, vae/, loras/, …). ADR 0004.
COMFY_MODELS_DIR=/home/CHANGE_ME/comfy-models

# Vision projectors (--mmproj), both currently commented out in
# docker-compose.backends.yml: Ornith (llama-chat) has no vision encoder,
# and llama-coder is kept text-only for now. Uncomment there to use these.
CHAT_MMPROJ_FILE=unsloth/Qwen3.6-35B-A3B-MTP-GGUF/mmproj-F32.gguf
CODER_MMPROJ_FILE=unsloth/Qwen3.6-35B-A3B-MTP-GGUF/mmproj-F32.gguf

# Host GIDs for /dev/dri GPU passthrough (Vulkan/RADV, ADR 0003).
# Find with: getent group render | cut -d: -f3
#            getent group video | cut -d: -f3
RENDER_GID=CHANGE_ME
VIDEO_GID=CHANGE_ME

# LiteLLM master key (admin / used to issue per-Client Keys).
# Generate with: echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=sk-CHANGE_ME

# Postgres credentials for LiteLLM's virtual Keys / spend tracking DB.
POSTGRES_USER=litellm
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=litellm

# Redis password for the Gateway's shared cache / rate-limit / router state.
# Internal to the Docker network (no published port), but set a real value —
# Redis accepts every command from anything that can reach it otherwise.
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME

# Grafana admin password (Grafana is LAN-facing on :3000).
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
