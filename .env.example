# Copy to .env and fill in real values. .env is gitignored.

# ---------------------------------------------------------------------------
# Compose
# ---------------------------------------------------------------------------

# Loads the real GPU-passthrough Backends (issues #2/#3) alongside the base
# stack, so `docker compose up -d` (no -f flags) starts everything. Remove
# this line (or use only -f docker-compose.yml) to run the Gateway stack
# without the Backends, e.g. against an already-running pair on :8001/:8002.
COMPOSE_FILE=docker-compose.yml:docker-compose.backends.yml

# ---------------------------------------------------------------------------
# Host: models directory and GPU passthrough
# ---------------------------------------------------------------------------

# Absolute path to the directory containing GGUF model files, mounted
# read-only into the Backends (issues #2/#3). Model and projector paths below
# are relative to it. A model split into shards (model-00001-of-00003.gguf)
# is referenced by its first shard.
MODELS_DIR=/home/CHANGE_ME/models

# Host GIDs for /dev/dri GPU passthrough (Vulkan/RADV, ADR 0003).
# Find with: getent group render | cut -d: -f3
#            getent group video | cut -d: -f3
RENDER_GID=CHANGE_ME
VIDEO_GID=CHANGE_ME

# ---------------------------------------------------------------------------
# Backends (docker-compose.backends.yml)
# ---------------------------------------------------------------------------

# llama-server flags per Backend: everything except -m, --mmproj and --port
# (those come from *_MODEL_FILE / *_MMPROJ_FILE). One line, unquoted, no "#",
# no spaces inside a single argument. This is also the SINGLE SOURCE for the
# Gateway: `make litellm-config` reads --ctx-size and --parallel from it and
# renders max_input_tokens (= ctx-size / parallel, the per-slot context) into
# litellm/config.yaml; supports_vision is true iff *_MMPROJ_FILE is set. Both
# flags are required, long form only, ctx-size divisible by parallel.
# Parallelism is a deliberate choice: a second slot slows the first at long
# context. After changing anything: make restart-backend (renders the config).

# --- llama-chat (:8001) ---
# MoE (Cyber-Tiel-Coder-35B-A3B) with MTP, Q4_K_XL. Drop-in alternatives, swap
# model and projector together:
# CHAT_MODEL_FILE=peculiar-ragdoll/Tiel-Coder-35B-A3B-GGUF-MTP/Tiel-Coder-35B-A3B-MTP-UD-Q4_K_XL.gguf
# CHAT_MMPROJ_FILE=peculiar-ragdoll/Tiel-Coder-35B-A3B-GGUF-MTP/mmproj-BF16.gguf
# CHAT_MODEL_FILE=ornith-ai/Ornith-1.5-35B-A3B-GGUF/Ornith-1.5-35B-Q4_K_M.gguf
# (the Ornith repo has no projector on disk; get one or leave CHAT_MMPROJ_FILE empty)
CHAT_MODEL_FILE=peculiar-ragdoll/Cyber-Tiel-Coder-35B-A3B-GGUF-MTP/Cyber-Tiel-Coder-35B-A3B-MTP-UD-Q4_K_XL.gguf
# Vision projector, optional: empty = text-only model (supports_vision false).
CHAT_MMPROJ_FILE=peculiar-ragdoll/Cyber-Tiel-Coder-35B-A3B-GGUF-MTP/mmproj-Q8_0.gguf
CHAT_ARGS=--ctx-size 524288 --parallel 4 --flash-attn on --n-gpu-layers 999 --load-mode mlock --cache-type-k q8_0 --cache-type-v q8_0 --jinja --reasoning-format auto --spec-type draft-mtp --spec-draft-n-max 2 --temp 0.6 --top-p 0.95 --top-k 20 --reasoning-preserve --cont-batching --metrics

# --- llama-coder (:8002) ---
# MoE (Qwen3.6-35B-A3B, ~3B active), Q8_K_XL -- ADR 0005 originally argued for
# a dense model on quality grounds; this live pick is not yet reconciled with
# that ADR (see docs/adr/decisions.md). In practice multimodal has run more
# reliably on this smaller MoE model than on a large dense one.
CODER_MODEL_FILE=unsloth/Qwen3.6-35B-A3B-MTP-GGUF/Qwen3.6-35B-A3B-UD-Q8_K_XL.gguf
CODER_MMPROJ_FILE=unsloth/Qwen3.6-35B-A3B-MTP-GGUF/mmproj-F16.gguf
CODER_ARGS=--ctx-size 524288 --parallel 2 --flash-attn on --n-gpu-layers 999 --load-mode mlock --cache-type-k q8_0 --cache-type-v q8_0 --jinja --reasoning-format auto --spec-type draft-mtp --spec-draft-n-max 2 --repeat-penalty 1.1 --presence-penalty 1.1 --temp 0.6 --top-p 0.95 --top-k 20 --min-p 0.0 --metrics

# --- llama-fim (:8004) ---
# Qwen3-Coder-30B-A3B (Q4_K_XL), one-week trial since 2026-10-10 (decode ~2x
# the 7B at similar prefill). ADR 0008 settled on Qwen2.5-Coder-7B-base; this
# live pick is not yet reconciled with that ADR. Rollback / lighter fallbacks:
# FIM_MODEL_FILE=QuantFactory/Qwen2.5-Coder-7B-GGUF/Qwen2.5-Coder-7B.Q6_K.gguf
# FIM_MODEL_FILE=QuantFactory/Qwen2.5-Coder-1.5B-GGUF/Qwen2.5-Coder-1.5B.Q8_0.gguf
FIM_MODEL_FILE=unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF/Qwen3-Coder-30B-A3B-Instruct-UD-Q4_K_XL.gguf
FIM_ARGS=--ctx-size 8192 --parallel 1 --n-gpu-layers 999 --flash-attn on --load-mode mlock --cache-type-k q8_0 --cache-type-v q8_0 --cache-reuse 256 --temp 1.0 --top-p 0.95 --top-k 40 --min-p 0.0 --repeat-penalty 1.0

# ---------------------------------------------------------------------------
# Gateway (LiteLLM), Postgres, Redis
# ---------------------------------------------------------------------------

# LiteLLM master key (admin / used to issue per-Client Keys).
# Generate with: echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=sk-CHANGE_ME

# Postgres credentials for LiteLLM's virtual Keys / spend tracking DB.
POSTGRES_USER=litellm
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=litellm

# Redis password for the Gateway's shared cache / rate-limit / router state.
# Internal to the Docker network (no published port), but set a real value --
# Redis accepts every command from anything that can reach it otherwise.
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------------------

# HF token for `hf download` (no Makefile target uses it right now): higher
# rate limits, and required for gated repos. Generate at
# https://huggingface.co/settings/tokens -- read-only scope is enough. Optional.
HF_TOKEN=hf_CHANGE_ME
