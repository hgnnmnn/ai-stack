# Copy to .env and fill in real values. .env is gitignored.

# Loads the real GPU-passthrough Backends (issues #2/#3) alongside the base
# stack, so `docker compose up -d` (no -f flags) starts everything. Remove
# this line (or use only -f docker-compose.yml) to run the Gateway stack
# without the Backends, e.g. against an already-running pair on :8001/:8002.
COMPOSE_FILE=docker-compose.yml:docker-compose.backends.yml

# Absolute path to the directory containing GGUF model files, mounted
# read-only into the Backends (issues #2/#3).
MODELS_DIR=/home/CHANGE_ME/models

# GGUF filenames within MODELS_DIR for each Backend, relative paths are fine.
# If a model is split into multiple shards (e.g. model-00001-of-00003.gguf),
# point at the first shard.

# llama-chat model. No vision projector currently set (see note on
# CODER_MMPROJ_FILE below). Previous vision-enabled default, kept as a
# drop-in if you want vision back on this Backend instead of the coder one:
# CHAT_MODEL_FILE=bartowski/Ornith-1.5-35B-A3B-GGUF/Ornith-1.5-35B-A3B-Q4_K_M.gguf
# CHAT_MMPROJ_FILE=bartowski/Ornith-1.5-35B-A3B-GGUF/mmproj-Ornith-1.5-35B-A3B-f16.gguf
CHAT_MODEL_FILE=gbuzhf/KAT-Coder-V2.5-Dev-MTP-GGUF/Kwaipilot_KAT-Coder-V2.5-Dev-MTP-UD-Q4_K_XL.gguf

# llama-coder model. MoE (Qwen3.6-35B-A3B, ~3B active) — ADR 0005
# originally argued for a dense model on quality grounds; this live pick is
# not yet reconciled with that ADR (see docs/adr/decisions.md). In practice
# multimodal (below) has run more reliably on this smaller MoE model than
# on a large dense one.
CODER_MODEL_FILE=unsloth/Qwen3.6-35B-A3B-MTP-GGUF/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf

# llama-fim model. MiniCPM5-2B — ADR 0008 settled on Qwen2.5-Coder-7B-base;
# this live pick is not yet reconciled with that ADR either. Drop-in
# lower-latency fallback:
# QuantFactory/Qwen2.5-Coder-1.5B-GGUF/Qwen2.5-Coder-1.5B.Q8_0.gguf
FIM_MODEL_FILE=bartowski/MiniCPM5-2B-GGUF/MiniCPM5-2B-Q8_0.gguf

# Vision projector (--mmproj in docker-compose.backends.yml). Only
# llama-coder currently runs one — CHAT_MMPROJ_FILE is commented above
# since KAT-Coder-V2.5-Dev-MTP ships no projector of its own.
CODER_MMPROJ_FILE=unsloth/Qwen3.6-35B-A3B-MTP-GGUF/mmproj-F32.gguf

# Host GIDs for /dev/dri GPU passthrough (Vulkan/RADV, ADR 0003).
# Find with: getent group render | cut -d: -f3
#            getent group video | cut -d: -f3
RENDER_GID=CHANGE_ME
VIDEO_GID=CHANGE_ME

# LiteLLM master key (admin / used to issue per-Client Keys).
# Generate with: echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=sk-CHANGE_ME

# Postgres credentials for LiteLLM's virtual Keys / spend tracking DB.
POSTGRES_USER=litellm
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=litellm

# Redis password for the Gateway's shared cache / rate-limit / router state.
# Internal to the Docker network (no published port), but set a real value —
# Redis accepts every command from anything that can reach it otherwise.
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME
